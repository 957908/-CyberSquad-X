# ==================================================
# CyberSquad X - Environment Variables Configuration
# ==================================================

# FastAPI Server Port
PORT=8000
HOST=127.0.0.1

# OpenAI API Configuration (Optional: Only if choosing OpenAI over local Ollama)
# OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama Configurations
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Security Tokens Config
JWT_SECRET=super_secure_secret_token_change_this_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
